# Auth: run `gcloud auth application-default login` locally — no key file needed
# On Cloud Run, the attached service account handles auth automatically.
GCP_PROJECT=mahitha-booking

# Admin panel login (HTTP Basic on /admin/*) — required, app fails to start without these.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Gmail SMTP + App Password (not your regular Gmail password — generate one at
# https://myaccount.google.com/apppasswords).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
HOST_EMAIL=mahitha@mahithavaka.com

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Set to your Cloud Run URL after deploying
APP_URL=http://localhost:5173
